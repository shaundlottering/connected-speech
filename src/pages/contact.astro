---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Contact Us | Connected Speech Sandton"
  description="Book a speech therapy session with Connected Speech in Sandton. In-person at our Morningside premises, home visits, school visits, or online. Medical aid and cash accepted."
  path="/contact"
  ogTitle="Contact Connected Speech | Speech Therapy Sandton"
  ogDescription="Get in touch with Connected Speech, a speech therapy practice in Sandton. We accept medical aid and cash."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://connectedspeech.co.za/contact" }
      ]
    },
    {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Connected Speech?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Connected speech is the term used in speech-language pathology to describe natural, continuous language as it occurs in real conversation and daily communication. Unlike isolated words or sounds produced in a clinical setting, connected speech involves the rhythm, flow, and interaction of language as it actually happens. Assessing and improving connected speech is central to what we do, because real communication happens in connection with other people."
        }
      },
      {
        "@type": "Question",
        "name": "Do you have an office?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We offer sessions at our private premises in Morningside, Sandton, as well as home visits and school visits. Whatever setting works best for you and your family, we will make it work."
        }
      },
      {
        "@type": "Question",
        "name": "Do you accept medical aid and cash?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We accept both medical aid and cash payments. We also submit to medical aid on your behalf, so there is nothing for you to chase. Speak to us about your specific plan and we will take it from there."
        }
      },
      {
        "@type": "Question",
        "name": "What ages do you work with?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We work with children from birth through school age and with adults at any stage of life. Whether you are a parent with concerns about your toddler or an adult navigating communication challenges after a stroke or other medical condition, we are here to help."
        }
      },
      {
        "@type": "Question",
        "name": "What is AAC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Augmentative and Alternative Communication (AAC) refers to tools and strategies that support communication beyond speech. This includes Makaton signing, picture-based systems, and high-tech communication devices. Jodi specialises in AAC and works with children and adults who communicate in ways that go beyond spoken words."
        }
      },
      {
        "@type": "Question",
        "name": "How do I know if my child needs speech therapy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you have any concerns about your child's speech, language development, feeding, or communication at any age, an assessment is always the right first step. Early intervention makes the biggest difference, and there is no such thing as seeking help too soon."
        }
      }
    ]
    }
  ]
  </script>

  <section class="section contact-page" aria-labelledby="contact-heading">
    <div class="section-inner">
      <div class="contact-layout">

        <!-- Left: details -->
        <div class="contact-info">
          <span class="section-label">Get in Touch</span>
          <h1 class="section-heading" id="contact-heading">You have something to say.<br/>Let's help you say it.</h1>
          <div class="section-body">
            <p>
              Whether you want to book a session, ask a question about your child's development, or find out
              whether speech therapy is the right next step — we are here to help.
            </p>
            <p>
              We work with children and adults across Sandton, Johannesburg. Sessions are available Monday
              to Thursday at our Morningside premises, at your home, at school, or
              <a href="/therapy-services/online-speech-therapy">online</a> — see
              <a href="/how-we-work">how sessions work</a> to find the right fit, or browse our
              <a href="/therapy-services">full range of therapy services</a>.
            </p>
          </div>
          <div class="contact-info-list" aria-label="Contact details">
            <div class="credential">
              <span class="credential-icon" aria-hidden="true">✦</span>
              <a href="mailto:jodi@connectedspeech.co.za">jodi@connectedspeech.co.za</a>
            </div>
            <div class="credential">
              <span class="credential-icon" aria-hidden="true">✦</span>
              <span>Morningside, Sandton, Johannesburg</span>
            </div>
            <div class="credential">
              <span class="credential-icon" aria-hidden="true">✦</span>
              <span>Available Monday to Thursday</span>
            </div>
            <div class="credential">
              <span class="credential-icon" aria-hidden="true">✦</span>
              <span>Medical aid and cash accepted</span>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div class="contact-form-col">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" aria-labelledby="contact-faq-heading">
    <div class="section-inner faq-inner">
      <span class="section-label">Questions</span>
      <h2 class="section-heading" id="contact-faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">What is Connected Speech?</summary>
          <div class="faq-answer">
            <p>Connected speech is the term used in speech-language pathology to describe natural, continuous language as it occurs in real conversation and daily communication. Unlike isolated words or sounds produced in a clinical setting, connected speech involves the rhythm, flow, and interaction of language as it actually happens. Assessing and improving connected speech is central to what we do, because real communication happens in connection with other people.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Do you have an office?</summary>
          <div class="faq-answer">
            <p>Your therapist can see you at our private premises in Morningside, Sandton, as well as through <a href="/how-we-work">home visits and school visits</a>. Whatever setting works best for you and your family, we will make it work.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Do you accept medical aid and cash?</summary>
          <div class="faq-answer">
            <p>Yes. We accept both medical aid and cash payments. We also submit to medical aid on your behalf, so there is nothing for you to chase. Speak to us about your specific plan and we will take it from there.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What ages do you work with?</summary>
          <div class="faq-answer">
            <p>Our therapist works with children from birth through school age and with adults at any stage of life. Whether you are a parent with concerns about your toddler or an adult navigating communication challenges after a stroke or other medical condition, we are here to help.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What is AAC?</summary>
          <div class="faq-answer">
            <p><a href="/therapy-services/special-needs-speech-therapy">Augmentative and Alternative Communication (AAC)</a> refers to tools and strategies that support communication beyond speech. This includes Makaton signing, picture-based systems, and high-tech communication devices. Jodi specialises in AAC and works with children and adults who communicate in ways that go beyond spoken words.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">How do I know if my child needs speech therapy?</summary>
          <div class="faq-answer">
            <p>If you have any concerns about your child's speech, language development, <a href="/therapy-services/feeding-therapy">feeding</a>, or communication at any age, speaking with a therapist is always the right first step. Early intervention makes the biggest difference, and there is no such thing as seeking help too soon.</p>
          </div>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-page { background: var(--white); }
  .contact-form-col {
    background: var(--purple-pale);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 2.25rem 2rem;
  }
</style>
