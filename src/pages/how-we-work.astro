---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="How We Work | Connected Speech Therapy"
  description="Speech therapy sessions at school, at home, at our Morningside premises, or online. See how Connected Speech fits therapy into your family's life."
  path="/how-we-work"
  ogTitle="How We Work | Connected Speech Therapy"
  ogDescription="Therapy that fits your life, not the other way around. School visits, home visits, private sessions, and online therapy, all with one dedicated therapist."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "How We Work", "item": "https://connectedspeech.co.za/how-we-work" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long will my child need therapy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "This depends entirely on the individual, including the nature of the challenge, the age at which therapy begins, how consistently goals are worked on at home and school, and how the child responds to intervention. Some children make rapid progress over a few months. Others benefit from longer-term support. Your therapist will give you a realistic picture after the assessment and will review progress regularly so that therapy remains purposeful and goal-driven."
          }
        },
        {
          "@type": "Question",
          "name": "What happens in a session?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sessions are play-based for younger children, because play is how children learn and the best therapy does not feel like work. For older children and adults, sessions are structured around specific, agreed goals using activities and approaches that are relevant to that person's life. After every session, parents and families receive a clear summary of what was worked on and how progress is going."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work with schools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Connected Speech has established school partnerships across the Johannesburg and Sandton area, providing therapy directly on school premises so that children receive support in the environment where they spend most of their day. If your child's school does not currently have a speech therapist on site, get in touch as we may be able to help."
          }
        },
        {
          "@type": "Question",
          "name": "Does medical aid cover speech therapy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most major medical aids in South Africa cover speech therapy, including Discovery, Momentum, Bonitas, and Medihelp, typically under chronic benefit, PMB (Prescribed Minimum Benefits), or savings. The specifics depend on your plan. We bill medical aid directly on your behalf, so you do not need to manage the claims process yourself. If you are unsure what your plan covers, contact your scheme and ask specifically about speech therapy benefits."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a screening and an assessment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A screening is a brief, free overview that gives an indication of whether there is a concern worth investigating further. It does not produce a detailed report or diagnosis. An assessment is a comprehensive evaluation that examines specific areas of communication in depth, identifies what is happening and why, and forms the basis of a therapy plan. If a screening suggests that further investigation is warranted, an assessment will be recommended."
          }
        }
      ]
    }
  ]
  </script>

  <!-- Intro -->
  <section class="section how-we-work-intro" aria-labelledby="how-we-work-heading">
    <div class="section-inner">
      <h1 class="section-label">How We Work</h1>
      <h2 class="section-heading" id="how-we-work-heading">Therapy that fits your life, not the other way around.</h2>
      <div class="section-body">
        <p>
          Every therapy plan at Connected Speech is built around the individual, and that includes deciding
          where and how sessions happen. Whether that is at school, at home, at our private premises, or online,
          the goal is the same: consistent, specialist support delivered in the setting that works best for you
          and your family.
        </p>
      </div>
    </div>
  </section>

  <!-- Formats -->
  <section class="section how-we-work-formats" aria-labelledby="formats-heading">
    <div class="section-inner">
      <h2 class="section-heading" id="formats-heading">Sessions in four formats</h2>
      <div class="delivery-grid">
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏫</span>
          <h3 class="delivery-title">School Visits</h3>
          <p class="delivery-desc">We visit your child's school to deliver therapy where learning happens, keeping sessions close to their everyday environment.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏠</span>
          <h3 class="delivery-title">Home Visits</h3>
          <p class="delivery-desc">Sessions in the comfort of your own home, where your child is relaxed and familiar, and the whole family can be part of the process.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">📍</span>
          <h3 class="delivery-title">Private Sessions</h3>
          <p class="delivery-desc">Our private premises in Morningside, Sandton offer a calm, dedicated therapy space for focused, uninterrupted sessions.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">💻</span>
          <h3 class="delivery-title">Online Therapy</h3>
          <p class="delivery-desc">Remote sessions via video call for those who prefer to meet from home, or where travel is not practical. <a href="/therapy-services/online-speech-therapy">Learn more about online therapy →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why it matters -->
  <section class="section reassurance" aria-labelledby="formats-why-heading">
    <div class="section-inner">
      <div class="reassurance-grid">
        <div class="reassurance-item">
          <span class="section-label">One Therapist, Every Format</span>
          <p class="section-body">Whichever formats you use, sessions are run by the same dedicated therapist, so there is no rotating roster and no handover gaps. Families and schools are kept informed with clear, specific progress reporting every step of the way.</p>
        </div>
        <div class="reassurance-item">
          <span class="section-label">Payment &amp; Medical Aid</span>
          <p class="section-body">Medical aid and cash are both accepted across every format, including school and home visits. Claims are submitted on your behalf, so there is nothing for you to chase.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="how-we-work-cta-heading">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="how-we-work-cta-heading">Not sure which format is right for you?</h2>
        <p>
          Get in touch and we will help you decide. Most families start with a free screening, then choose
          the setting that fits their routine, whether that stays the same every week or changes as needed.
        </p>
        <p class="cta-note">
          Want to see the services themselves? <a href="/therapy-services" style="color: var(--white); text-decoration: underline;">View all therapy services →</a>
        </p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" aria-labelledby="how-we-work-faq-heading">
    <div class="section-inner faq-inner">
      <span class="section-label">Questions</span>
      <h2 class="section-heading" id="how-we-work-faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">How long will my child need therapy?</summary>
          <div class="faq-answer">
            <p>This depends entirely on the individual, including the nature of the challenge, the age at which therapy begins, how consistently goals are worked on at home and school, and how the child responds to intervention. Some children make rapid progress over a few months. Others benefit from longer-term support. Your therapist will give you a realistic picture after the assessment and will review progress regularly so that therapy remains purposeful and goal-driven.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What happens in a session?</summary>
          <div class="faq-answer">
            <p>Sessions are play-based for younger children, because play is how children learn and the best therapy does not feel like work. For older children and adults, sessions are structured around specific, agreed goals using activities and approaches that are relevant to that person's life. After every session, parents and families receive a clear summary of what was worked on and how progress is going.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Do you work with schools?</summary>
          <div class="faq-answer">
            <p>Yes. Connected Speech has established <a href="/therapy-services/school-based-speech-therapy">school partnerships</a> across the Johannesburg and Sandton area, providing therapy directly on school premises so that children receive support in the environment where they spend most of their day. If your child's school does not currently have a speech therapist on site, get in touch as we may be able to help.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Does medical aid cover speech therapy?</summary>
          <div class="faq-answer">
            <p>Most major medical aids in South Africa cover speech therapy, including Discovery, Momentum, Bonitas, and Medihelp, typically under chronic benefit, PMB (Prescribed Minimum Benefits), or savings. The specifics depend on your plan. We bill medical aid directly on your behalf, so you do not need to manage the claims process yourself. If you are unsure what your plan covers, contact your scheme and ask specifically about speech therapy benefits.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What is the difference between a screening and an assessment?</summary>
          <div class="faq-answer">
            <p>A screening is a brief, free overview that gives an indication of whether there is a concern worth investigating further. It does not produce a detailed report or diagnosis. An assessment is a comprehensive evaluation that examines specific areas of communication in depth, identifies what is happening and why, and forms the basis of a therapy plan. If a screening suggests that further investigation is warranted, an assessment will be recommended.</p>
          </div>
        </details>
      </div>
    </div>
  </section>
</Layout>
