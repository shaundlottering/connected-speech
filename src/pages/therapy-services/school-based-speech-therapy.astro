---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Speech Therapy for Schools in Sandton | Connected Speech"
  description="Connected Speech offers onsite speech-language therapy for schools in Sandton and Johannesburg. Free screenings, no logistics for staff, medical aid handled directly with families."
  path="/therapy-services/school-based-speech-therapy"
  ogTitle="Onsite Speech Therapy for Schools | Connected Speech Sandton"
  ogDescription="Bring speech therapy onto your campus. Connected Speech partners with schools in Sandton and Johannesburg for onsite therapy, free screenings, and specialist AAC support."
>

  <!-- Intro -->
  <section class="section schools-intro" aria-labelledby="schools-heading">
    <div class="section-inner">
      <div class="schools-intro-grid">
        <div class="schools-intro-text">
          <span class="section-label">For Schools</span>
          <h1 class="section-heading" id="schools-heading">Onsite speech-language therapy for schools in Sandton and Johannesburg.</h1>
          <div class="section-body">
            <p>
              Bring speech therapy onto your campus, without the logistics falling on you. Connected Speech
              is a private speech-language pathology practice that partners with schools across Sandton and
              Johannesburg, delivering sessions in your classrooms and therapy spaces, on a day that suits
              your timetable.
            </p>
            <p>
              Sessions are run by a single dedicated therapist — Jodi Zimmerman — who your staff and families
              get to know by name. No rotating roster. No handover gaps. Consistent, specialist support from
              someone who is genuinely invested in your learners.
            </p>
          </div>
          <a href="#partner-form" class="btn-primary">Get in Touch</a>
        </div>
        <div class="schools-intro-card" aria-hidden="true">
          <p class="schools-quote">"You have learners who have something to say. Let's help you help them say it."</p>
          <span class="schools-quote-attr">— Jodi Zimmerman, Speech-Language Pathologist</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Why schools choose us -->
  <section class="section schools-why" aria-labelledby="schools-why-heading">
    <div class="section-inner">
      <span class="section-label">Why Schools Choose Us</span>
      <h2 class="section-heading" id="schools-why-heading">Everything your learners need. None of the administration.</h2>
      <div class="schools-why-grid">
        <div class="schools-why-card">
          <span class="why-icon" aria-hidden="true">🏫</span>
          <h3 class="why-title">On your campus</h3>
          <p class="why-desc">Therapy happens in your classroom or a quiet space you provide. No travel, no missed lesson time, no parents chasing appointments across the city.</p>
        </div>
        <div class="schools-why-card">
          <span class="why-icon" aria-hidden="true">🔍</span>
          <h3 class="why-title">Free screenings</h3>
          <p class="why-desc">Group or individual screenings for learners of concern, at no cost and with no commitment attached. A clear picture of who needs support before any sessions begin.</p>
        </div>
        <div class="schools-why-card">
          <span class="why-icon" aria-hidden="true">🤝</span>
          <h3 class="why-title">Specialist in AAC</h3>
          <p class="why-desc">Deep expertise in complex communication needs, Makaton, PROMPT, and augmentative devices — not only articulation. The right support for every learner on your roll.</p>
        </div>
        <div class="schools-why-card">
          <span class="why-icon" aria-hidden="true">📋</span>
          <h3 class="why-title">Medical aid handled</h3>
          <p class="why-desc">Claims are submitted directly to families' medical aid funds on their behalf. Parents are not left to chase paperwork, and your admin team is not involved.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What we support -->
  <section class="section schools-support" aria-labelledby="schools-support-heading">
    <div class="section-inner">
      <span class="section-label">What We Work On</span>
      <h2 class="section-heading" id="schools-support-heading">Support for the communication challenges that affect learning.</h2>
      <p class="schools-support-intro">
        From early language delays to complex communication needs, we work with learners at every stage
        and with every profile. All services are delivered on your premises, within your school day.
      </p>
      <ul class="schools-support-list">
        <li class="schools-support-item">Language delays and language &amp; literacy development</li>
        <li class="schools-support-item">Articulation and speech intelligibility</li>
        <li class="schools-support-item">Complex communication needs &amp; AAC — Makaton, PROMPT, and devices</li>
        <li class="schools-support-item">Feeding and oral motor difficulties</li>
        <li class="schools-support-item">Stuttering and stammering, at any age</li>
      </ul>
    </div>
  </section>

  <!-- How a partnership works -->
  <section class="section schools-process" aria-labelledby="schools-process-heading">
    <div class="section-inner">
      <span class="section-label">How It Works</span>
      <h2 class="section-heading" id="schools-process-heading">Five steps from first contact to sessions on campus.</h2>
      <ol class="schools-steps">
        <li class="schools-step">
          <span class="step-number" aria-hidden="true">01</span>
          <div class="step-body">
            <h3 class="step-title">A short call</h3>
            <p class="step-desc">We start with a brief conversation to understand your learners' needs and your timetable. No forms, no paperwork — just a conversation.</p>
          </div>
        </li>
        <li class="schools-step">
          <span class="step-number" aria-hidden="true">02</span>
          <div class="step-body">
            <h3 class="step-title">Free screenings</h3>
            <p class="step-desc">Free individual or group screenings for learners you have identified as needing support. We assess who would benefit from therapy and report back clearly.</p>
          </div>
        </li>
        <li class="schools-step">
          <span class="step-number" aria-hidden="true">03</span>
          <div class="step-body">
            <h3 class="step-title">A schedule is set</h3>
            <p class="step-desc">A simple weekly onsite schedule is agreed on, Monday to Thursday, built around your timetable and the needs of your learners.</p>
          </div>
        </li>
        <li class="schools-step">
          <span class="step-number" aria-hidden="true">04</span>
          <div class="step-body">
            <h3 class="step-title">Sessions begin on campus</h3>
            <p class="step-desc">Therapy happens at school. Medical aid claims are submitted directly to families' funds. Your admin team is not involved.</p>
          </div>
        </li>
        <li class="schools-step">
          <span class="step-number" aria-hidden="true">05</span>
          <div class="step-body">
            <h3 class="step-title">Clear progress reporting</h3>
            <p class="step-desc">Progress is reported clearly to you and to families at every stage. You always know how your learners are doing.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- About Jodi -->
  <section class="section schools-jodi" aria-labelledby="schools-jodi-heading">
    <div class="section-inner">
      <div class="schools-jodi-inner">
        <span class="section-label">The Therapist</span>
        <h2 class="section-heading" id="schools-jodi-heading">A specialist who knows what schools need.</h2>
        <div class="section-body">
          <p>
            Jodi Zimmerman spent four years embedded in a government school for children with autism before
            founding Connected Speech. She understands the realities of a school environment — the timetable
            pressures, the range of learner profiles, the importance of working alongside educators rather than
            in isolation from them.
          </p>
          <p>
            Her master's degree specialised in Augmentative and Alternative Communication, with research into
            youth empowerment and participation for learners with disabilities. She brings that depth of
            knowledge into every school she works with.
          </p>
        </div>
        <div class="schools-credentials">
          <div class="credential"><span class="credential-icon" aria-hidden="true">✦</span><span>BSc Speech-Language Pathology, University of Cape Town, 2016</span></div>
          <div class="credential"><span class="credential-icon" aria-hidden="true">✦</span><span>MSc Augmentative &amp; Alternative Communication, University of Pretoria, 2022</span></div>
          <div class="credential"><span class="credential-icon" aria-hidden="true">✦</span><span>8 years of clinical experience in speech therapy</span></div>
          <div class="credential"><span class="credential-icon" aria-hidden="true">✦</span><span>4 years embedded in a government school for children with autism</span></div>
          <div class="credential"><span class="credential-icon" aria-hidden="true">✦</span><span>Practice No. 0735620</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA with form -->
  <section class="cta-section" aria-labelledby="schools-cta-heading" id="partner-form">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="schools-cta-heading">Bring speech therapy to your school.</h2>
        <p>
          Get in touch to arrange a call, request a free screening for your learners, or find out how
          a partnership with Connected Speech would work for your school. We serve schools across
          Sandton and Johannesburg, Monday to Thursday.
        </p>
        <p class="cta-note">Free screenings available. Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Intro */
  .schools-intro { background: var(--white); }
  .schools-intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .schools-intro-text .btn-primary { margin-top: 2rem; }

  .schools-intro-card {
    background: var(--purple-light);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .schools-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    color: var(--purple-mid);
    line-height: 1.6;
  }
  .schools-quote-attr {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--purple);
  }

  /* Why */
  .schools-why { background: var(--purple-pale); }
  .schools-why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .schools-why-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    padding: 2rem;
  }
  .why-icon { font-size: 1.75rem; display: block; margin-bottom: 1rem; }
  .why-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
    margin-bottom: 0.6rem;
  }
  .why-desc { font-size: 0.95rem; line-height: 1.7; color: var(--body); }

  /* Support */
  .schools-support { background: var(--white); }
  .schools-support-intro {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--body);
    max-width: 680px;
    margin-bottom: 2rem;
  }
  .schools-support-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem 3rem;
  }
  .schools-support-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1rem;
    color: var(--body);
    line-height: 1.5;
  }
  .schools-support-item::before {
    content: '—';
    color: var(--purple);
    flex-shrink: 0;
    font-weight: 600;
  }

  /* Process */
  .schools-process { background: var(--purple-light); }
  .schools-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 2.5rem;
    max-width: 720px;
  }
  .schools-step {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(150, 84, 199, 0.15);
  }
  .schools-step:first-child { border-top: 1px solid rgba(150, 84, 199, 0.15); }
  .step-number {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--purple);
    font-weight: 600;
    flex-shrink: 0;
    width: 2.5rem;
    line-height: 1.4;
  }
  .step-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .step-desc { font-size: 0.95rem; line-height: 1.7; color: var(--body); }

  /* Jodi */
  .schools-jodi { background: var(--white); }
  .schools-jodi-inner { max-width: 720px; }
  .schools-credentials {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .schools-intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .schools-why-grid { grid-template-columns: 1fr; }
    .schools-support-list { grid-template-columns: 1fr; }
  }
</style>
