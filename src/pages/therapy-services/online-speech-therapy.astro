---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Online Speech Therapy | Connected Speech Sandton"
  description="Online speech therapy via video call for children and adults, in Sandton, Johannesburg, or anywhere else. Language, articulation, stuttering, AAC coaching, and stroke recovery support."
  path="/therapy-services/online-speech-therapy"
  ogTitle="Online Speech Therapy | Connected Speech"
  ogDescription="Therapy that fits your life, not the other way around. The same individualised, specialist care as an in-person session, through a video call."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" },
        { "@type": "ListItem", "position": 3, "name": "Online Speech Therapy", "item": "https://connectedspeech.co.za/therapy-services/online-speech-therapy" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://connectedspeech.co.za/therapy-services/online-speech-therapy#service",
      "name": "Online Speech Therapy",
      "serviceType": "Online Speech-Language Therapy",
      "description": "Individualised speech therapy delivered via video call, covering language and literacy, articulation, stuttering, AAC coaching, and stroke and medical condition support.",
      "url": "https://connectedspeech.co.za/therapy-services/online-speech-therapy",
      "provider": { "@id": "https://connectedspeech.co.za/#business" },
      "areaServed": { "@type": "Country", "name": "South Africa" },
      "audience": {
        "@type": "Audience",
        "audienceType": "Children and adults who prefer remote sessions or live outside Sandton and Johannesburg"
      }
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/therapy-services">Therapy Services</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Online Speech Therapy</span>
  </nav>

  <!-- Intro -->
  <section class="section how-we-work-intro" aria-labelledby="online-heading">
    <div class="section-inner">
      <span class="section-label">Online Speech Therapy</span>
      <h1 class="section-heading" id="online-heading">Therapy that fits your life, not the other way around.</h1>
      <div class="section-body">
        <p>
          Online speech therapy delivers the same individualised, specialist care as an in-person session,
          through a video call instead of a shared room. It suits families and adults who prefer to avoid
          travel, who live outside Sandton and Johannesburg, or who simply want therapy to fit into a busy
          week without adding a commute to it.
        </p>
        <p>
          Therapy does not stop when the session ends, whether it happens online or in person, and progress
          is reported to you clearly either way.
        </p>
      </div>
      <div class="hero-actions" style="margin-top: 2rem;">
        <a href="#online-cta" class="btn-primary">Book a Free Screening</a>
      </div>
    </div>
  </section>

  <!-- What online therapy can help with -->
  <section class="section conditions" aria-labelledby="online-conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <span class="section-label">What We Work On</span>
        <h2 class="section-heading" id="online-conditions-heading">What online therapy can help with</h2>
      </div>
      <div class="conditions-grid" role="list">
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">📚</span>
          <h3 class="condition-title">Language &amp; Literacy Development</h3>
          <p class="condition-desc">
            Building vocabulary, sentence structure, and the foundations of reading and writing works well
            over video, especially with a parent or caregiver nearby to support in between sessions.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🔊</span>
          <h3 class="condition-title">Articulation &amp; Intelligibility</h3>
          <p class="condition-desc">
            Sound and speech clarity work can be coached effectively online, with clear modelling, practice,
            and feedback in real time.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🗣️</span>
          <h3 class="condition-title">Stuttering &amp; Stammering</h3>
          <p class="condition-desc">
            Fluency work, confidence building, and practical strategies translate well to a video call, for
            children and adults alike.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🤝</span>
          <h3 class="condition-title">AAC Coaching &amp; Follow-Up</h3>
          <p class="condition-desc">
            For families and individuals already using an AAC system, Makaton, or PROMPT strategies, online
            sessions are an efficient way to coach, troubleshoot, and build on progress between in-person visits.
            <a href="/therapy-services/special-needs-speech-therapy">Learn more about special needs speech therapy →</a>
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🧠</span>
          <h3 class="condition-title">Stroke &amp; Medical Condition Support</h3>
          <p class="condition-desc">
            For adults recovering from a stroke or managing a medical condition, online sessions are often
            the easiest way to keep therapy consistent, particularly when travel is difficult.
          </p>
        </article>
      </div>
      <p class="conditions-note">
        Some needs are better suited to in-person care, particularly early
        <a href="/therapy-services/feeding-therapy">feeding therapy</a> and initial hands-on assessments. If
        that is the case for you, we will say so honestly and recommend the right format.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="section how-we-work" aria-labelledby="online-process-heading">
    <div class="section-inner">
      <span class="section-label">How It Works</span>
      <h2 class="section-heading" id="online-process-heading">Five steps to your first online session.</h2>
      <ol class="process-steps">
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">01</span>
          <div class="step-body">
            <h3 class="process-step-title">A free screening</h3>
            <p class="process-step-desc">We start with a free screening, available online, with no cost and no commitment required, to understand what is happening and whether a full assessment is recommended.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">02</span>
          <div class="step-body">
            <h3 class="process-step-title">An assessment</h3>
            <p class="process-step-desc">Assessments can often be completed online too, giving us a clear, accurate picture of what is going on before we build a plan.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">03</span>
          <div class="step-body">
            <h3 class="process-step-title">A therapy plan built around you</h3>
            <p class="process-step-desc">Every plan is built around the individual's needs and their pace, adapted for the online format so that it is just as targeted as an in-person plan.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">04</span>
          <div class="step-body">
            <h3 class="process-step-title">A simple, private video call</h3>
            <p class="process-step-desc">Sessions run on a straightforward video call platform. All you need is a device with a camera, a stable internet connection, and a quiet space to sit for the session. Prefer an in-person option? <a href="/how-we-work">See how sessions work →</a></p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">05</span>
          <div class="step-body">
            <h3 class="process-step-title">Progress you can see</h3>
            <p class="process-step-desc">Between sessions, you will receive clear guidance on what to practise at home or at school, and progress is reported specifically and honestly, every step of the way.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Payment & urgency -->
  <section class="section reassurance" aria-labelledby="online-reassurance-heading">
    <div class="section-inner">
      <div class="reassurance-grid">
        <div class="reassurance-item">
          <span class="section-label">Payment &amp; Medical Aid</span>
          <p class="section-body">Medical aid and cash are both accepted. Claims are submitted on your behalf, so there is nothing for you to chase.</p>
        </div>
        <div class="reassurance-item">
          <span class="section-label">There Is No Such Thing As Too Soon</span>
          <p class="section-body">If travel, distance, or a busy schedule has been the only thing standing between you and getting help, online therapy removes that barrier. A consultation is always the right first step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section related-services" aria-labelledby="online-related-heading">
    <div class="section-inner">
      <span class="section-label">Related Services</span>
      <h2 class="section-heading" id="online-related-heading">Other ways we can help</h2>
      <div class="related-grid">
        <a class="related-card" href="/therapy-services/speech-therapy">
          <span class="related-icon" aria-hidden="true">💬</span>
          <h3 class="related-title">Speech Therapy</h3>
          <p class="related-desc">Language delays, articulation, stuttering, and more, for children and adults at every stage of life.</p>
        </a>
        <a class="related-card" href="/therapy-services/feeding-therapy">
          <span class="related-icon" aria-hidden="true">🍽️</span>
          <h3 class="related-title">Feeding Therapy</h3>
          <p class="related-desc">Support for children who struggle with textures, chewing, or swallowing, best started in person.</p>
        </a>
        <a class="related-card" href="/therapy-services/special-needs-speech-therapy">
          <span class="related-icon" aria-hidden="true">🤝</span>
          <h3 class="related-title">Special Needs Speech Therapy</h3>
          <p class="related-desc">Specialist AAC, Makaton, and PROMPT support for complex communication needs and autism spectrum communication differences.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="online-cta-heading" id="online-cta">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="online-cta-heading">Therapy that fits your life, not the other way around.</h2>
        <p>
          Book a free screening or get in touch to find out whether online speech therapy is the right fit
          for you or your family.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>
</Layout>

<style>
  .conditions-note {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--body);
  }
  .conditions-note a { color: var(--purple-mid); font-weight: 600; }
  .conditions-note a:hover { color: var(--purple); }
</style>
