---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Speech Therapy Sandton | Connected Speech"
  description="Speech therapy for children and adults in Sandton. Language delays, articulation, stuttering, stroke recovery, and complex communication needs, built around the individual."
  path="/therapy-services/speech-therapy"
  ogTitle="Speech Therapy | Connected Speech Sandton"
  ogDescription="You have something to say. Let's help you say it. Speech therapy for children and adults in Sandton, at home, at school, or online."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" },
        { "@type": "ListItem", "position": 3, "name": "Speech Therapy", "item": "https://connectedspeech.co.za/therapy-services/speech-therapy" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://connectedspeech.co.za/therapy-services/speech-therapy#service",
      "name": "Speech Therapy",
      "serviceType": "Speech-Language Therapy",
      "description": "Speech therapy for language delays, literacy development, articulation and intelligibility, stuttering, stroke and medical conditions, and complex communication needs.",
      "url": "https://connectedspeech.co.za/therapy-services/speech-therapy",
      "provider": { "@id": "https://connectedspeech.co.za/#business" },
      "areaServed": [
        { "@type": "City", "name": "Sandton" },
        { "@type": "City", "name": "Johannesburg" }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Children and adults with speech, language, or communication difficulties"
      }
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/therapy-services">Therapy Services</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Speech Therapy</span>
  </nav>

  <!-- Intro -->
  <section class="section how-we-work-intro" aria-labelledby="speech-heading">
    <div class="section-inner">
      <h1 class="section-label">Speech Therapy</h1>
      <h2 class="section-heading" id="speech-heading">You have something to say. Let's help you say it.</h2>
      <div class="section-body">
        <p>
          Speech therapy is the process of building the skills someone needs to communicate clearly and
          confidently, whether that means finding the right sounds, the right words, the right sentence
          structure, or the right tool to express a thought. At Connected Speech, therapy is built around
          the individual: their needs, their pace, and their world.
        </p>
        <p>
          We work with children from birth through school age, and with adults at any stage of life,
          including those recovering from a stroke or living with a lifelong communication difference.
        </p>
      </div>
      <div class="hero-actions" style="margin-top: 2rem;">
        <a href="#speech-cta" class="btn-primary">Book a Free Screening</a>
      </div>
    </div>
  </section>

  <!-- What speech therapy addresses -->
  <section class="section conditions" aria-labelledby="speech-conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <span class="section-label">What We Work On</span>
        <h2 class="section-heading" id="speech-conditions-heading">What speech therapy addresses</h2>
      </div>
      <div class="conditions-grid" role="list">
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">💬</span>
          <h3 class="condition-title">Language Delays</h3>
          <p class="condition-desc">
            When language milestones are not being met, early intervention makes the biggest difference. We
            identify what is holding a child back and build the specific skills they need to communicate
            their needs, connect with others, and thrive at school.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">📚</span>
          <h3 class="condition-title">Language &amp; Literacy Development</h3>
          <p class="condition-desc">
            Strong language skills are the foundation for reading and writing. We build the vocabulary,
            sentence structure, and phonological awareness a child needs to develop literacy skills and
            succeed at school.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🔊</span>
          <h3 class="condition-title">Articulation &amp; Intelligibility</h3>
          <p class="condition-desc">
            Speech that is difficult to understand can affect confidence and connection. We work on accurate
            sound production and clear speech patterns, so a person can be understood the first time, by
            anyone.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🗣️</span>
          <h3 class="condition-title">Stuttering &amp; Stammering</h3>
          <p class="condition-desc">
            Stuttering and stammering affect both children and adults, and the impact goes far beyond
            speech. Your therapist works with you and your family to build fluency, confidence, and the
            tools to communicate without fear, at any age.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🧠</span>
          <h3 class="condition-title">Stroke &amp; Medical Conditions</h3>
          <p class="condition-desc">
            We support adults recovering from strokes and other medical conditions that affect
            communication, helping them rebuild the skills they need to express themselves and reconnect
            with the people in their lives.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🤝</span>
          <h3 class="condition-title">Complex Communication Needs</h3>
          <p class="condition-desc">
            Some people communicate in ways that go beyond speech, and that is okay. We support children and
            adults with AAC, Makaton signing, the PROMPT system, and individualised strategies.
            <a href="/therapy-services/special-needs-speech-therapy">Learn more about special needs speech therapy →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section how-we-work" aria-labelledby="speech-process-heading">
    <div class="section-inner">
      <span class="section-label">How It Works</span>
      <h2 class="section-heading" id="speech-process-heading">Five steps from first contact to real progress.</h2>
      <ol class="process-steps">
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">01</span>
          <div class="step-body">
            <h3 class="process-step-title">A free screening</h3>
            <p class="process-step-desc">Not sure whether therapy is needed? Start with a free screening, open to individuals and to schools, and get a clear answer on whether a full assessment makes sense — no cost, no obligation.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">02</span>
          <div class="step-body">
            <h3 class="process-step-title">An assessment</h3>
            <p class="process-step-desc">When a full assessment is recommended, we look closely at what is happening, why it is happening, and what a realistic path forward looks like for your child or for you.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">03</span>
          <div class="step-body">
            <h3 class="process-step-title">A therapy plan built around you</h3>
            <p class="process-step-desc">Every plan is built for the person in front of us: their pace, their goals, and the environments where they actually need to communicate, at home, at school, or at work.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">04</span>
          <div class="step-body">
            <h3 class="process-step-title">Sessions that fit your life</h3>
            <p class="process-step-desc">Choose what works for you: school visits, home visits, our Morningside premises, or <a href="/therapy-services/online-speech-therapy">online sessions</a>. <a href="/how-we-work">See how sessions work →</a></p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">05</span>
          <div class="step-body">
            <h3 class="process-step-title">Progress you can see</h3>
            <p class="process-step-desc">Therapy does not stop when the session ends. You will get clear, specific updates on progress after every session, not vague check-ins.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section related-services" aria-labelledby="speech-related-heading">
    <div class="section-inner">
      <span class="section-label">Related Services</span>
      <h2 class="section-heading" id="speech-related-heading">Other ways we can help</h2>
      <div class="related-grid">
        <a class="related-card" href="/therapy-services/feeding-therapy">
          <span class="related-icon" aria-hidden="true">🍽️</span>
          <h3 class="related-title">Feeding Therapy</h3>
        </a>
        <a class="related-card" href="/therapy-services/special-needs-speech-therapy">
          <span class="related-icon" aria-hidden="true">🤝</span>
          <h3 class="related-title">Special Needs Speech Therapy</h3>
        </a>
        <a class="related-card" href="/therapy-services/online-speech-therapy">
          <span class="related-icon" aria-hidden="true">💻</span>
          <h3 class="related-title">Online Speech Therapy</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="speech-cta-heading" id="speech-cta">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="speech-cta-heading">You have something to say.<br/>Let's help you say it.</h2>
        <p>
          Book a free screening or get in touch to find out whether speech therapy is the right next step
          for you or your family.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>
</Layout>
