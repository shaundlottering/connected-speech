---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Speech Therapy Services Sandton | Connected Speech"
  description="From language delays and stuttering to feeding therapy, AAC, and stroke recovery. Specialist speech therapy for children and adults in Sandton, at home, at school, or online."
path="/therapy-services"
  ogTitle="Speech Therapy Services | Connected Speech Sandton"
  ogDescription="From language delays and stuttering to feeding therapy, AAC, and stroke recovery. Specialist speech therapy for children and adults in Sandton, at home, at school, or online."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Therapy Services",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://connectedspeech.co.za/therapy-services/speech-therapy#service" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://connectedspeech.co.za/therapy-services/feeding-therapy#service" } },
        { "@type": "ListItem", "position": 3, "item": { "@id": "https://connectedspeech.co.za/therapy-services/special-needs-speech-therapy#service" } },
        { "@type": "ListItem", "position": 4, "item": { "@id": "https://connectedspeech.co.za/therapy-services/school-based-speech-therapy#service" } }
      ]
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Therapy Services</span>
  </nav>

  <!-- What We Work On -->
  <section class="section conditions" aria-labelledby="conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <span class="section-label">What We Work On</span>
        <h1 class="section-heading" id="conditions-heading">Support for the communication challenges that affect everyday life.</h1>
        <p class="section-body">
          Our therapist works with children from birth through to school age, and with adults navigating communication
          challenges at any stage of life. Every person receives a therapy plan built specifically for them.
        </p>
      </div>

      <div class="conditions-grid" role="list">
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">💬</span>
          <h3 class="condition-title">Language Delays</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/feeding-therapy">
          <span class="condition-icon" aria-hidden="true">🍽️</span>
          <h3 class="condition-title">Feeding Therapy</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">🗣️</span>
          <h3 class="condition-title">Stuttering &amp; Stammering</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/special-needs-speech-therapy">
          <span class="condition-icon" aria-hidden="true">🤝</span>
          <h3 class="condition-title">Complex Communication Needs</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">🧠</span>
          <h3 class="condition-title">Stroke &amp; Medical Conditions</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">📚</span>
          <h3 class="condition-title">Language &amp; Literacy Development</h3>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">🔊</span>
          <h3 class="condition-title">Articulation &amp; Intelligibility</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section how-we-work" aria-labelledby="services-how-heading">
    <div class="section-inner">
      <span class="section-label">How We Work</span>
      <h2 class="section-heading" id="services-how-heading">Therapy that fits your life, not the other way around.</h2>
      <div class="delivery-grid">
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏫</span>
          <h3 class="delivery-title">School Visits</h3>
          <p class="delivery-desc">We visit your child's school to deliver therapy where learning happens, keeping sessions close to their everyday environment.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏠</span>
          <h3 class="delivery-title">Home Visits</h3>
          <p class="delivery-desc">Sessions in the comfort of your own home, where your child is relaxed and familiar, and the whole family can be part of the process.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">📍</span>
          <h3 class="delivery-title">Private Sessions</h3>
          <p class="delivery-desc">Our private premises in Morningside, Sandton offer a calm, dedicated therapy space for focused, uninterrupted sessions.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">💻</span>
          <h3 class="delivery-title">Online Speech Therapy</h3>
          <p class="delivery-desc">Remote sessions via video call for those who prefer to meet from home, or where travel is not practical. <a href="/therapy-services/online-speech-therapy">Learn more about online therapy →</a></p>
        </div>
      </div>
      <a href="/how-we-work" class="btn-ghost" style="margin-top: 1.5rem; display: inline-block;">More about how sessions work →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="services-cta-heading">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="services-cta-heading">You have something to say.<br/>Let's help you say it.</h2>
        <p>
          Our therapist works with families and individuals across Sandton, Johannesburg. Sessions are billed
          through medical aid and cash. Speak to us about availability and we will take it from there.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>
</Layout>
