---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Speech Therapy Services Sandton | Connected Speech"
  description="From language delays and stuttering to feeding therapy, AAC, and stroke recovery. Specialist speech therapy for children and adults in Sandton, at home, at school, or online."
path="/therapy-services"
  ogTitle="Speech Therapy Services | Connected Speech Sandton"
  ogDescription="From language delays and stuttering to feeding therapy, AAC, and stroke recovery. Specialist speech therapy for children and adults in Sandton, at home, at school, or online."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Therapy Services",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://connectedspeech.co.za/therapy-services/speech-therapy#service" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://connectedspeech.co.za/therapy-services/feeding-therapy#service" } },
        { "@type": "ListItem", "position": 3, "item": { "@id": "https://connectedspeech.co.za/therapy-services/special-needs-speech-therapy#service" } },
        { "@type": "ListItem", "position": 4, "item": { "@id": "https://connectedspeech.co.za/therapy-services/school-based-speech-therapy#service" } }
      ]
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Therapy Services</span>
  </nav>

  <!-- What We Work On -->
  <section class="section conditions" aria-labelledby="conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <h1 class="section-label">Our Services</h1>
        <h2 class="section-heading" id="conditions-heading">Four services, one therapist, a plan built around you.</h2>
        <p class="section-body">
          Not sure where to start? Here is a quick guide to which service page covers what you are looking
          for, and you can always <a href="/contact">get in touch directly</a> if you are still not sure.
        </p>
      </div>

      <div class="conditions-grid" role="list">
        <a class="condition-card" role="listitem" href="/therapy-services/speech-therapy">
          <span class="condition-icon" aria-hidden="true">💬</span>
          <h3 class="condition-title">Speech Therapy</h3>
          <p class="condition-desc">Our core service, covering language delays, literacy, articulation, stuttering, and stroke or medical-condition related communication difficulties, for children and adults.</p>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/feeding-therapy">
          <span class="condition-icon" aria-hidden="true">🍽️</span>
          <h3 class="condition-title">Feeding Therapy</h3>
          <p class="condition-desc">For children who struggle with textures, chewing, swallowing, or selective eating. A different skill set to speech, but closely related, and delivered by the same therapist.</p>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/special-needs-speech-therapy">
          <span class="condition-icon" aria-hidden="true">🤝</span>
          <h3 class="condition-title">Special Needs Speech Therapy</h3>
          <p class="condition-desc">Our AAC specialism: Makaton, PROMPT, and high-tech devices for anyone whose communication needs go beyond typical speech and language development.</p>
        </a>
        <a class="condition-card" role="listitem" href="/therapy-services/school-based-speech-therapy">
          <span class="condition-icon" aria-hidden="true">🏫</span>
          <h3 class="condition-title">For Schools</h3>
          <p class="condition-desc">Onsite partnerships for schools in Sandton, Johannesburg, and Randburg, with free group screenings and one dedicated therapist your staff and families get to know.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section how-we-work" aria-labelledby="services-how-heading">
    <div class="section-inner">
      <span class="section-label">Session Formats</span>
      <h2 class="section-heading" id="services-how-heading">Delivered wherever it works best for you.</h2>
      <p class="section-body">
        Every service above can be delivered at school, at home, at our Morningside premises, or
        <a href="/therapy-services/online-speech-therapy">online via video call</a>. There is no separate
        pricing tier for format. You choose what fits, and it can change as your circumstances do.
      </p>
      <a href="/how-we-work" class="btn-ghost" style="margin-top: 1.5rem; display: inline-block;">See exactly how sessions work →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="services-cta-heading">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="services-cta-heading">Still not sure which service is right?</h2>
        <p>
          Tell us what you are noticing, in a child or in yourself, and we will point you to the right
          service, or recommend a free screening if that is the clearer next step.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>
</Layout>
