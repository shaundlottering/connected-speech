---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Special Needs Speech Therapy Sandton | Connected Speech"
  description="Specialist AAC, Makaton, and PROMPT therapy for children and adults with complex communication needs, led by an AAC specialist in Sandton."
  path="/therapy-services/special-needs-speech-therapy"
  ogTitle="Special Needs Speech Therapy | Connected Speech Sandton"
  ogDescription="Everyone deserves to be heard. Every family deserves to be connected. Specialist AAC, Makaton, and PROMPT support in Sandton."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za/" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" },
        { "@type": "ListItem", "position": 3, "name": "Special Needs Speech Therapy", "item": "https://connectedspeech.co.za/therapy-services/special-needs-speech-therapy" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://connectedspeech.co.za/therapy-services/special-needs-speech-therapy#service",
      "name": "Special Needs Speech Therapy",
      "serviceType": "Augmentative and Alternative Communication (AAC) Therapy",
      "description": "Specialist speech therapy for complex communication needs, including AAC, Makaton signing, the PROMPT system, and autism spectrum communication support.",
      "url": "https://connectedspeech.co.za/therapy-services/special-needs-speech-therapy",
      "provider": { "@id": "https://connectedspeech.co.za/#business" },
      "areaServed": [
        { "@type": "City", "name": "Sandton" },
        { "@type": "City", "name": "Johannesburg" }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Children and adults with complex communication needs, including autism spectrum communication differences"
      }
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/therapy-services">Therapy Services</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Special Needs Speech Therapy</span>
  </nav>

  <!-- Intro -->
  <section class="section how-we-work-intro" aria-labelledby="special-needs-heading">
    <div class="section-inner">
      <span class="section-label">Special Needs Speech Therapy</span>
      <h1 class="section-heading" id="special-needs-heading">Everyone deserves to be heard. Every family deserves to be connected.</h1>
      <div class="section-body">
        <p>
          Special needs speech therapy supports children and adults whose communication needs go beyond
          typical speech and language development, including complex communication needs, autism spectrum
          communication differences, and conditions that call for augmentative or alternative approaches. It
          is a specialist area, and one Jodi has built her career around.
        </p>
        <p>
          Jodi holds a Master's degree in Augmentative and Alternative Communication (AAC) from the
          University of Pretoria, and spent four years embedded in a government school for children with
          autism. That experience shaped her belief that every person is capable of communicating when given
          the right tools, the right environment, and someone who truly believes in them.
        </p>
      </div>
      <div class="hero-actions" style="margin-top: 2rem;">
        <a href="#special-needs-cta" class="btn-primary">Book a Free Screening</a>
      </div>
    </div>
  </section>

  <!-- What special needs speech therapy addresses -->
  <section class="section conditions" aria-labelledby="special-needs-conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <span class="section-label">What We Work On</span>
        <h2 class="section-heading" id="special-needs-conditions-heading">What special needs speech therapy addresses</h2>
      </div>
      <div class="conditions-grid" role="list">
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🤝</span>
          <h3 class="condition-title">Complex Communication Needs</h3>
          <p class="condition-desc">
            Some people communicate in ways that go beyond speech, and that is okay. We build individualised
            strategies around how a person communicates best, not around a standard template.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🖥️</span>
          <h3 class="condition-title">Augmentative &amp; Alternative Communication (AAC)</h3>
          <p class="condition-desc">
            AAC covers the tools and strategies that support communication beyond speech, including
            picture-based systems and high-tech communication devices. We help children and adults find the
            right system and learn to use it with confidence, at home, at school, and out in the world.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🤲</span>
          <h3 class="condition-title">Makaton Signing</h3>
          <p class="condition-desc">
            A structured signing system used alongside speech to support understanding and expression,
            especially valuable for children who are not yet reliably verbal.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">👐</span>
          <h3 class="condition-title">The PROMPT System</h3>
          <p class="condition-desc">
            A hands-on approach to building the physical movements behind speech, used with children and
            adults who need extra support developing clear, accurate sound production.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🧩</span>
          <h3 class="condition-title">Autism Spectrum Communication Support</h3>
          <p class="condition-desc">
            Communication support shaped around how each person on the spectrum communicates and learns
            best, built on years of embedded, in-school experience rather than theory alone.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section how-we-work" aria-labelledby="special-needs-process-heading">
    <div class="section-inner">
      <span class="section-label">How It Works</span>
      <h2 class="section-heading" id="special-needs-process-heading">Five steps to finding what works.</h2>
      <ol class="process-steps">
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">01</span>
          <div class="step-body">
            <h3 class="process-step-title">A free screening</h3>
            <p class="process-step-desc">We start with a free screening, with no cost and no commitment required, to understand how someone currently communicates and where support could help most.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">02</span>
          <div class="step-body">
            <h3 class="process-step-title">An assessment</h3>
            <p class="process-step-desc">A full assessment looks closely at communication across environments, not just in a clinical setting, so the picture we build is a real one.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">03</span>
          <div class="step-body">
            <h3 class="process-step-title">A therapy plan built around the individual</h3>
            <p class="process-step-desc">Every plan is built around the person's needs, their pace, and the people and places in their world. There is no single AAC system or approach that fits everyone.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">04</span>
          <div class="step-body">
            <h3 class="process-step-title">Sessions that fit your life</h3>
            <p class="process-step-desc">Therapy should fit your life, not the other way around. Sessions are available at school, at home, at our Morningside premises, or online. <a href="/how-we-work">See how sessions work →</a></p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">05</span>
          <div class="step-body">
            <h3 class="process-step-title">A partnership with your family and your team</h3>
            <p class="process-step-desc">Therapy does not stop when the session ends. We work alongside families, schools, and other professionals involved in a person's care, so strategies are used consistently everywhere they are needed.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Payment & urgency -->
  <section class="section reassurance" aria-labelledby="special-needs-reassurance-heading">
    <div class="section-inner">
      <div class="reassurance-grid">
        <div class="reassurance-item">
          <span class="section-label">Payment &amp; Medical Aid</span>
          <p class="section-body">Medical aid and cash are both accepted. Claims are submitted on your behalf, so there is nothing for you to chase.</p>
        </div>
        <div class="reassurance-item">
          <span class="section-label">There Is No Such Thing As Too Soon</span>
          <p class="section-body">If you are wondering whether AAC, Makaton, or specialist support could help your child or a family member, a consultation is always the right first step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section related-services" aria-labelledby="special-needs-related-heading">
    <div class="section-inner">
      <span class="section-label">Related Services</span>
      <h2 class="section-heading" id="special-needs-related-heading">Other ways we can help</h2>
      <div class="related-grid">
        <a class="related-card" href="/therapy-services/speech-therapy">
          <span class="related-icon" aria-hidden="true">💬</span>
          <h3 class="related-title">Speech Therapy</h3>
          <p class="related-desc">Language delays, articulation, stuttering, and more, for children and adults at every stage of life.</p>
        </a>
        <a class="related-card" href="/therapy-services/feeding-therapy">
          <span class="related-icon" aria-hidden="true">🍽️</span>
          <h3 class="related-title">Feeding Therapy</h3>
          <p class="related-desc">Support for children who struggle with textures, chewing, or swallowing, delivered by the same speech-language pathologist.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="special-needs-cta-heading" id="special-needs-cta">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="special-needs-cta-heading">With words, with signs, with anything that works.</h2>
        <p>
          Book a free screening or get in touch to find out how AAC, Makaton, or PROMPT could help you or a
          family member communicate with confidence.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>
</Layout>
