---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout
  title="Feeding Therapy Sandton | Connected Speech"
  description="Feeding therapy for children who struggle with textures, chewing, swallowing, or selective eating. Delivered by a speech-language pathologist in Sandton."
  path="/therapy-services/feeding-therapy"
  ogTitle="Feeding Therapy | Connected Speech Sandton"
  ogDescription="Mealtimes should not be a source of stress. Feeding therapy for children in Sandton, at home, at school, or online."
>
  <script slot="head" type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://connectedspeech.co.za" },
        { "@type": "ListItem", "position": 2, "name": "Therapy Services", "item": "https://connectedspeech.co.za/therapy-services" },
        { "@type": "ListItem", "position": 3, "name": "Feeding Therapy", "item": "https://connectedspeech.co.za/therapy-services/feeding-therapy" }
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://connectedspeech.co.za/therapy-services/feeding-therapy#service",
      "name": "Feeding Therapy",
      "serviceType": "Paediatric Feeding Therapy",
      "description": "Feeding therapy for children with oral motor difficulties, texture aversions, swallowing difficulties, and selective or restricted eating, delivered by a speech-language pathologist.",
      "url": "https://connectedspeech.co.za/therapy-services/feeding-therapy",
      "provider": { "@id": "https://connectedspeech.co.za/#business" },
      "areaServed": [
        { "@type": "City", "name": "Sandton" },
        { "@type": "City", "name": "Johannesburg" }
      ],
      "audience": {
        "@type": "Audience",
        "audienceType": "Children with feeding, swallowing, or oral motor difficulties"
      }
    }
  ]
  </script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    <a href="/therapy-services">Therapy Services</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Feeding Therapy</span>
  </nav>

  <!-- Intro -->
  <section class="section how-we-work-intro" aria-labelledby="feeding-heading">
    <div class="section-inner">
      <h1 class="section-label">Feeding Therapy</h1>
      <h2 class="section-heading" id="feeding-heading">Mealtimes should not be a source of stress.</h2>
      <div class="section-body">
        <p>
          Feeding therapy supports children who struggle with the physical or sensory side of eating,
          whether that shows up as difficulty with certain textures, trouble chewing or swallowing safely,
          or a mealtime that ends in tears more often than not. It is delivered by a
          <a href="/therapy-services/speech-therapy">speech-language pathologist</a> because feeding and
          swallowing rely on many of the same oral muscles and coordination skills used in speech.
        </p>
        <p>
          We help children eat more comfortably and confidently, so that mealtimes become easier for the
          whole family.
        </p>
      </div>
      <div class="hero-actions" style="margin-top: 2rem;">
        <a href="#feeding-cta" class="btn-primary">Book a Free Screening</a>
      </div>
    </div>
  </section>

  <!-- What feeding therapy addresses -->
  <section class="section conditions" aria-labelledby="feeding-conditions-heading">
    <div class="section-inner">
      <div class="conditions-intro">
        <span class="section-label">What We Work On</span>
        <h2 class="section-heading" id="feeding-conditions-heading">What feeding therapy addresses</h2>
      </div>
      <div class="conditions-grid" role="list">
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">💪</span>
          <h3 class="condition-title">Oral Motor Skills</h3>
          <p class="condition-desc">
            Some children have not yet developed the strength, coordination, or control in their jaw,
            tongue, and lips needed to chew and swallow a full range of foods safely and comfortably.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🍽️</span>
          <h3 class="condition-title">Texture Difficulties</h3>
          <p class="condition-desc">
            A child may manage purées or soft foods well but struggle, gag, or refuse when textures change,
            which can narrow their diet and make family mealtimes stressful.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">💧</span>
          <h3 class="condition-title">Swallowing Difficulties</h3>
          <p class="condition-desc">
            Some children have genuine difficulty coordinating a safe swallow, which needs careful,
            professional support rather than pressure or persuasion at the table.
          </p>
        </article>
        <article class="condition-card" role="listitem">
          <span class="condition-icon" aria-hidden="true">🥗</span>
          <h3 class="condition-title">Selective or Restricted Eating</h3>
          <p class="condition-desc">
            When a limited diet is rooted in sensory or motor difficulty rather than simple fussiness,
            therapy addresses the underlying cause instead of just the behaviour at mealtimes.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section how-we-work" aria-labelledby="feeding-process-heading">
    <div class="section-inner">
      <span class="section-label">How It Works</span>
      <h2 class="section-heading" id="feeding-process-heading">Five steps to easier mealtimes.</h2>
      <ol class="process-steps">
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">01</span>
          <div class="step-body">
            <h3 class="process-step-title">A free screening</h3>
            <p class="process-step-desc">We start by understanding what is happening at mealtimes: what is difficult, when, and how often. No cost, no commitment, just a clear next step.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">02</span>
          <div class="step-body">
            <h3 class="process-step-title">An assessment</h3>
            <p class="process-step-desc">A full assessment looks at oral motor skills, texture tolerance, swallowing safety, and the mealtime environment, so we understand exactly what is driving the difficulty.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">03</span>
          <div class="step-body">
            <h3 class="process-step-title">A therapy plan built around your child</h3>
            <p class="process-step-desc">Every plan is built around the individual child, their pace, and their specific triggers, never a generic one-size-fits-all programme.</p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">04</span>
          <div class="step-body">
            <h3 class="process-step-title">Support close to mealtimes</h3>
            <p class="process-step-desc">Feeding therapy works best close to real mealtimes. Sessions are available at home, at school, at our Morningside premises, or <a href="/therapy-services/online-speech-therapy">online</a> for follow-up and coaching. <a href="/how-we-work">See how sessions work →</a></p>
          </div>
        </li>
        <li class="process-step">
          <span class="process-step-number" aria-hidden="true">05</span>
          <div class="step-body">
            <h3 class="process-step-title">Family involvement, every step</h3>
            <p class="process-step-desc">Feeding is a family experience. Parents and caregivers are treated as partners, not bystanders, with practical strategies you can use at every meal, not just in session.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="feeding-cta-heading" id="feeding-cta">
    <div class="cta-grid">
      <div class="cta-grid-text">
        <h2 id="feeding-cta-heading">Mealtimes should not be a source of stress.</h2>
        <p>
          Book a free screening or get in touch to find out whether feeding therapy could help your child
          and your family.
        </p>
        <p class="cta-note">Medical aid and cash accepted.</p>
      </div>
      <div class="cta-grid-form">
        <ContactForm dark />
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section related-services" aria-labelledby="feeding-related-heading">
    <div class="section-inner">
      <span class="section-label">Related Services</span>
      <h2 class="section-heading" id="feeding-related-heading">Other ways we can help</h2>
      <div class="related-grid">
        <a class="related-card" href="/therapy-services/speech-therapy">
          <span class="related-icon" aria-hidden="true">💬</span>
          <h3 class="related-title">Speech Therapy</h3>
        </a>
        <a class="related-card" href="/therapy-services/special-needs-speech-therapy">
          <span class="related-icon" aria-hidden="true">🤝</span>
          <h3 class="related-title">Special Needs Speech Therapy</h3>
        </a>
        <a class="related-card" href="/therapy-services/online-speech-therapy">
          <span class="related-icon" aria-hidden="true">💻</span>
          <h3 class="related-title">Online Speech Therapy</h3>
        </a>
      </div>
    </div>
  </section>
</Layout>
