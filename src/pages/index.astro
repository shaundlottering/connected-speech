---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/connected-speech-logo-transparent.png';
---

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Connected Speech?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Connected speech is the term used in speech-language pathology to describe natural, continuous language as it occurs in real conversation and daily communication. Unlike isolated words or sounds produced in a clinical setting, connected speech involves the rhythm, flow, and interaction of language as it actually happens. Assessing and improving connected speech is central to what we do, because real communication happens in connection with other people."
      }
    },
    {
      "@type": "Question",
      "name": "Do you have an office?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer sessions at our private premises in Morningside, Sandton, as well as home visits and school visits. Whatever setting works best for you and your family, we will make it work."
      }
    },
    {
      "@type": "Question",
      "name": "Do you accept medical aid and cash?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We accept both medical aid and cash payments. We also submit to medical aid on your behalf, so there is nothing for you to chase. Speak to us about your specific plan and we will take it from there."
      }
    },
    {
      "@type": "Question",
      "name": "What ages do you work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We work with children from birth through school age and with adults at any stage of life. Whether you are a parent with concerns about your toddler or an adult navigating communication challenges after a stroke or other medical condition, we are here to help."
      }
    },
    {
      "@type": "Question",
      "name": "What is AAC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Augmentative and Alternative Communication (AAC) refers to tools and strategies that support communication beyond speech. This includes Makaton signing, picture-based systems, and high-tech communication devices. Jodi specialises in AAC and works with children and adults who communicate in ways that go beyond spoken words."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if my child needs speech therapy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you have any concerns about your child's speech, language development, feeding, or communication at any age, an assessment is always the right first step. Early intervention makes the biggest difference, and there is no such thing as seeking help too soon."
      }
    }
  ]
}
</script>

<Layout
  title="Connected Speech Therapist Sandton"
  description="Connected Speech provides specialist speech therapy in Sandton for children and adults. We give people the ability to communicate their needs, with words, with signs, with whatever works for them."
path="/"
  ogTitle="Connected Speech | Speech Therapy Sandton"
  ogDescription="Everyone deserves to be heard. Every family deserves to be connected. Specialist speech therapy in Sandton, Johannesburg."
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-text">
      <span class="hero-eyebrow">Speech Therapy · Sandton</span>
      <h1 class="hero-headline" id="hero-heading">
        We give people the ability to <span class="underline-word">communicate their needs</span>.
      </h1>
      <p class="hero-sub">
        For some, that means a child saying <strong>"mom"</strong> or <strong>"dad"</strong> for the first time.
        For others, it means being understood at the dinner table, in the classroom, at work, or anywhere that matters.
        With words, with signs, with anything that works.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Book a Session</a>
        <a href="/about" class="btn-ghost">Learn more about us</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-logo-card">
        <Image src={logo} alt="Connected Speech" width={180} densities={[1, 2]} />
        <p class="hero-logo-tagline">The day your child communicates what they need, and gets it.</br>That's what we work towards.</p>
      </div>
    </div>
  </section>

  <!-- Mission Bar -->
  <div class="mission-bar" aria-label="Our mission">
    <p>Everyone deserves to be heard. Every family deserves to be connected.</p>
  </div>

  <!-- Services at a Glance -->
  <section class="section how-we-work" aria-labelledby="services-glance-heading">
    <div class="section-inner">
      <span class="section-label">What We Work On</span>
      <h2 class="section-heading" id="services-glance-heading">Services at a Glance</h2>
      <ul class="services-glance-list">
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">💬</span>Language Delays</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">📚</span>Language &amp; Literacy Development</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">🔊</span>Articulation &amp; Intelligibility</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">🍽️</span>Feeding Therapy</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">🗣️</span>Stuttering</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">🤝</span>Complex Communication Needs</li>
        <li class="services-glance-item"><span class="services-glance-icon" aria-hidden="true">🧠</span>Stroke &amp; Medical Conditions</li>
      </ul>
      <a href="/services" class="btn-ghost">View all services →</a>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="section about-cs" aria-labelledby="home-about-heading">
    <div class="section-inner">
      <div class="about-cs-grid">
        <div class="about-cs-text">
          <span class="section-label">Who We Are</span>
          <h2 class="section-heading" id="home-about-heading">Built on one belief: everyone thrives when communication is consistent.</h2>
          <div class="section-body">
            <p>
              Connected Speech is a Sandton based private speech therapy practice working with children and adults
              who face communication challenges. We work with those who stutter, with language delays,
              feeding therapy, and with complex communication needs.
            </p>
          </div>
          <div class="values-list" aria-label="Our values">
            <div class="value-item">
              <div class="value-dot" aria-hidden="true"></div>
              <p><strong>Person-centred.</strong> Every therapy plan is built around the individual: their needs, their pace, their world.</p>
            </div>
            <div class="value-item">
              <div class="value-dot" aria-hidden="true"></div>
              <p><strong>Inclusive by design.</strong> Communication takes many forms. We support all of them.</p>
            </div>
            <div class="value-item">
              <div class="value-dot" aria-hidden="true"></div>
              <p><strong>Family-first.</strong> Families are partners in therapy, not bystanders. We make sure you know exactly how to support your loved one between sessions.</p>
            </div>
            <div class="value-item">
              <div class="value-dot" aria-hidden="true"></div>
              <p><strong>Results you can see.</strong> Real progress, reported clearly, after every session.</p>
            </div>
          </div>
          <div class="hero-actions" style="margin-top: 2rem;">
            <a href="/about" class="btn-ghost">More about us</a>
          </div>
        </div>
        <div class="about-cs-visual" aria-hidden="true">
          <Image src={logo} alt="Connected Speech" width={200} densities={[1, 2]} />
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="section how-we-work" aria-labelledby="how-we-work-heading">
    <div class="section-inner">
      <span class="section-label">How We Work</span>
      <h2 class="section-heading" id="how-we-work-heading">Therapy that fits your life, not the other way around.</h2>
      <div class="delivery-grid">
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏫</span>
          <h3 class="delivery-title">School Visits</h3>
          <p class="delivery-desc">We visit your child's school to deliver therapy where learning happens, keeping sessions close to their everyday environment.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">🏠</span>
          <h3 class="delivery-title">Home Visits</h3>
          <p class="delivery-desc">Sessions in the comfort of your own home, where your child is relaxed and familiar, and the whole family can be part of the process.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">📍</span>
          <h3 class="delivery-title">Private Sessions</h3>
          <p class="delivery-desc">Our private premises in Morningside, Sandton offer a calm, dedicated therapy space for focused, uninterrupted sessions.</p>
        </div>
        <div class="delivery-card">
          <span class="delivery-icon" aria-hidden="true">💻</span>
          <h3 class="delivery-title">Online Speech Therapy</h3>
          <p class="delivery-desc">Remote sessions via video call for those who prefer to meet from home, or where travel is not practical.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Free Screenings -->
  <section class="section screening-section" aria-labelledby="screening-heading">
    <div class="section-inner screening-inner">
      <div class="screening-content">
        <span class="section-label">No Commitment</span>
        <h2 class="section-heading" id="screening-heading">Free screenings for individuals and schools.</h2>
        <p>Not sure where to start? A free screening gives you a clear picture of whether a full assessment is recommended, with no commitment required. We offer individual screenings as well as visits to schools for group screenings.</p>
        <a href="/contact" class="btn-primary">Book a Free Screening</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" aria-labelledby="faq-heading">
    <div class="section-inner faq-inner">
      <span class="section-label">Questions</span>
      <h2 class="section-heading" id="faq-heading">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">What is Connected Speech?</summary>
          <div class="faq-answer">
            <p>Connected speech is the term used in speech-language pathology to describe natural, continuous language as it occurs in real conversation and daily communication. Unlike isolated words or sounds produced in a clinical setting, connected speech involves the rhythm, flow, and interaction of language as it actually happens. Assessing and improving connected speech is central to what we do, because real communication happens in connection with other people.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Do you have an office?</summary>
          <div class="faq-answer">
            <p>We offer sessions at our private premises in Morningside, Sandton, as well as home visits and school visits. Whatever setting works best for you and your family, we will make it work.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Do you accept medical aid and cash?</summary>
          <div class="faq-answer">
            <p>Yes. We accept both medical aid and cash payments. We also submit to medical aid on your behalf, so there is nothing for you to chase. Speak to us about your specific plan and we will take it from there.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What ages do you work with?</summary>
          <div class="faq-answer">
            <p>We work with children from birth through school age and with adults at any stage of life. Whether you are a parent with concerns about your toddler or an adult navigating communication challenges after a stroke or other medical condition, we are here to help.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">What is AAC?</summary>
          <div class="faq-answer">
            <p>Augmentative and Alternative Communication (AAC) refers to tools and strategies that support communication beyond speech. This includes Makaton signing, picture-based systems, and high-tech communication devices. Jodi specialises in AAC and works with children and adults who communicate in ways that go beyond spoken words.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">How do I know if my child needs speech therapy?</summary>
          <div class="faq-answer">
            <p>If you have any concerns about your child's speech, language development, feeding, or communication at any age, an assessment is always the right first step. Early intervention makes the biggest difference, and there is no such thing as seeking help too soon.</p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <h2 id="cta-heading">You have something to say.<br/>Let's help you say it.</h2>
    <p>
      We work with families and individuals across Sandton, Johannesburg. Sessions are billed through
      medical aid and cash. Speak to us about availability and we will take it from there.
    </p>
    <a href="/contact" class="btn-white">Get in Touch</a>
    <p class="cta-note">Medical aid rates apply.</p>
  </section>
</Layout>
